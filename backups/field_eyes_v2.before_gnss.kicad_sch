	(text
		"A. SOLAR INPUT + MPPT CHARGER (CN3791, 1 cell, 4.2 V)"
		(exclude_from_sim no)
		(at 27.62 139.38 0)
		(effects (font (size 2 2) (bold yes)) (justify left top))
		(uuid "2b2cd308-d379-4f97-a847-9d5f0b93b387")
	)
	(text
		"Panel: 6 V nominal, 1-2 W (Voc <= 8 V). Q101 = reverse-polarity protection (on when the panel is the right way round).\nCharge current = 120 mV / R103 = 1.0 A max (the panel limits it further). MPPT holds the panel at\n1.205 V x (1 + R105/R106) = 5.40 V, a little under Vmp so it still tracks when the panel is hot.\nCHG_INHIBIT high (Q103 on) pulls MPPT low and stops charging - firmware uses it above 45 C or below 0 C\n(the CN3791 has no temperature input). /DONE unused -> GND (datasheet)."
		(exclude_from_sim no)
		(at 27.62 143.38 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "282ca6e8-385d-473d-9a54-c589814a896b")
	)
