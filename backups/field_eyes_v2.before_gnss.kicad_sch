	(text
		"3  A7672S LTE MODEM, SIM, ANTENNA"
		(exclude_from_sim no)
		(at 17.62 420.56 0)
		(effects (font (size 4 4) (bold yes)) (justify left bottom))
		(uuid "5f1fc746-4e1d-40ee-8389-159ae4e3d355")
	)
	(text
		"RS485 SOIL SENSORS (two buses: the SMT100 is 8E1, the 7-in-1 8N1)"
		(exclude_from_sim no)
		(at 439.1 436.56 0)
		(effects (font (size 2 2) (bold yes)) (justify left top))
		(uuid "3e7decbc-709a-4551-8853-6045fcb9571f")
	)
	(text
		"MAX485ESA+T (the chip on the old board) on +5V_SENS, made by U405 (78L05) from the 12 V sensor rail, so it only has power\nwhile SENS_EN is on. RO swings 0-5 V: the 3.3k + 6.8k divider gives the ESP32 3.4 V (its pins are not 5 V tolerant).\nDirection is automatic: TX idle-high turns the MMBT3904 on and holds DE/RE low (receive); a 0 bit releases DE so the driver\npulls the bus low; 1 bits come from the 4.7k bias. 10 R + SM712 protect the field cable. 120 R not fitted (short cable, 9600 baud).\nConnectors X1 (7-in-1) and X2 (SMT100) are 4-pin JST XH, pin 1 A, 2 B, 3 +12 V, 4 GND, like the old board.\nFirmware: set the TX pins low/input before switching the sensors off, or they feed the unpowered chips."
		(exclude_from_sim no)
		(at 439.1 440.56 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "ba58a961-e6b1-43fc-b96b-c4aad8033ccb")
	)
	(text
		"SMT100"
		(exclude_from_sim no)
		(at 439.1 474.56 0)
		(effects (font (size 1.5 1.5) (bold yes)) (justify left top))
		(uuid "efe9dc8b-0a68-4232-a07a-adbed9874b95")
	)
